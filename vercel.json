{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/pauta",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/pauta/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/about",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/about/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/Sergio_Ambrozio_CV.pdf",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/api/feed",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=300, stale-while-revalidate=3600"
        }
      ]
    }
  ]
}
