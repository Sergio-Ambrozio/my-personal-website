# Live homepage feed — set these in Vercel:
# Project → Settings → Environment Variables
# Apply to Production, Preview, and Development, then redeploy.

# Preferred: X API app Bearer token (read access to GET /2/users/:id/tweets).
# Do not commit the value. Name must be exactly:
X_BEARER_TOKEN=

# Fallback if X is missing, 401/403, or returns nothing:
# Notion internal integration token, with access to the Editorial database.
# Rows used: Status = Published AND URL is an x.com status link.
NOTION_TOKEN=

# Optional. Defaults to the Think in public / Editorial board.
# NOTION_EDITORIAL_DATABASE_ID=df9eafe858ea49209f3935a1ecfe844e
